<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextoSaldo">
        <item name="android:fontFamily">@font/familia_mono_semibold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoValorLista">
        <item name="android:fontFamily">@font/familia_mono_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoTituloTela">
        <item name="android:fontFamily">@font/familia_outfit_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoItemLista">
        <item name="android:fontFamily">@font/familia_outfit_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoCorpo">
        <item name="android:fontFamily">@font/familia_outfit_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="RotuloMono">
        <item name="android:fontFamily">@font/familia_mono_medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/texto_apoio</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Metadado">
        <item name="android:fontFamily">@font/familia_mono_regular</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/texto_apoio</item>
    </style>

</resources>
